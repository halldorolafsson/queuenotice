# Køvarsel – eksempel på miljøvariabler. Kopier til .env og tilpass.
# Ingen hemmeligheter skal ligge i denne filen.

# ----- Grunnoppsett -----
PORT=8080
LOG_LEVEL=info
APP_BASE_URL=http://localhost:5173

# Lokal innebygd Postgres (PGlite) i mappen .data. Ingen installasjon nødvendig.
DATABASE_URL=pglite:./.data/pglite
# I drift (Cloud SQL via Unix-socket i Cloud Run):
# DATABASE_URL=postgresql://kovarsel:PASSORD@localhost/kovarsel?host=/cloudsql/PROSJEKT:europe-north1:INSTANS

# ----- Innlogging -----
# password: e-post og passord med økter i informasjonskapsel (standard).
# iap: Google Identity-Aware Proxy foran Cloud Run. Krever IAP_AUDIENCE.
# dev: alle forespørsler regnes som DEV_USER_EMAIL (bare tester; stoppes i produksjon).
AUTH_MODE=password
SESSION_DAYS=30
DEV_USER_EMAIL=meg@localhost.test
# IAP_AUDIENCE=/projects/PROSJEKTNUMMER/locations/europe-north1/services/kovarsel
# ALLOWED_EMAILS=din.adresse@gmail.com

# ----- Trafikkilder -----
# Kommaseparert: vegvesen (ekte, åpen, gratis), google (betalt, se under) og/eller demo (eksempeldata merket DEMO).
TRAFFIC_SOURCES=vegvesen,demo
# Område som hentes (lon,lat,lon,lat). Standard dekker Trøndelag.
VEGVESEN_BBOX=8.5,62.2,14.5,65.5
NVDB_CLIENT_ID=kovarsel-personlig

# ----- Google Maps Routes API (betalt, estimert forsinkelse per strekning) -----
# Aktiveres ved å legge til "google" i TRAFFIC_SOURCES. Hemmelig nøkkel; begrens den til Routes API.
GOOGLE_ROUTES_API_KEY=
# Minst så mange minutter mellom kall for samme strekning og retning.
GOOGLE_ROUTES_MIN_INTERVAL_MINUTES=10
# Tak på antall kall. 5 000 kall per måned er gratis hos Google (Compute Routes Pro).
GOOGLE_ROUTES_MAX_CALLS_PER_DAY=150
GOOGLE_ROUTES_MAX_CALLS_PER_MONTH=4500
# true: bare lister med valgt tidsrom spørres (hindrer døgnkontinuerlige kall).
GOOGLE_ROUTES_REQUIRE_SCHEDULE=true

# ----- Innhenting -----
# true: serveren henter selv med fast intervall (lokalt / én alltid-på instans).
# false: bruk Cloud Scheduler + Cloud Run Job (npm run poll).
POLL_IN_PROCESS=true
POLL_INTERVAL_SECONDS=300
STALE_AFTER_MINUTES=15

# ----- Varsling -----
# dry-run: ingenting sendes, varsler vises bare i loggen. live: sender ekte push/e-post.
NOTIFY_MODE=dry-run
MAX_NOTIFICATIONS_PER_DAY=40

# Web Push (gratis). Lag nøkler med: npx web-push generate-vapid-keys
# Den offentlige nøkkelen er ikke hemmelig; den private er det.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:din.adresse@example.com

# E-post via SMTP (f.eks. Gmail med app-passord eller en e-posttjeneste).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
