{
  "name": "queuenotice-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx --env-file-if-exists=../.env src/db/migrateCli.ts",
    "poll": "tsx --env-file-if-exists=../.env src/jobs/pollOnce.ts",
    "user": "tsx --env-file-if-exists=../.env src/cli/users.ts",
    "transfer": "tsx --env-file-if-exists=../.env src/cli/transfer.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "express": "^5.3.0",
    "google-auth-library": "^11.3.0",
    "nodemailer": "^10.1.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "^0.2.13",
    "@types/express": "^5.0.6",
    "@types/node": "^24",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
